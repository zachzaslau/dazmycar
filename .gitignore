# Operating system files
.DS_Store
Thumbs.db

# Local environment settings (keep examples)
.env
.env.*
!.env.example
!.env.*.example

# JavaScript dependencies and builds
node_modules/
dist/
*.tsbuildinfo

# Python virtual environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/

# Test, coverage and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage/
playwright-report/
test-results/

# Local datasets, generated indexes and search caches
/data/raw/*
/data/prepared/*
/data/cache/*
!/data/raw/.gitkeep
!/data/prepared/.gitkeep
!/data/cache/.gitkeep

# Logs and temporary editor files
*.log
*.swp
*.swo
*~